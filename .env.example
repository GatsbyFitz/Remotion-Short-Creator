# Copy to .env (server / Docker) or .env.local (local dev) and fill in.

# --- Required: AI steps -----------------------------------------------------
# Whisper transcription in transcribeVideoFile.ts
OPENAI_API_KEY=

# The instruction-generation steps call AI Gateway model ids (google/gemini-3-flash).
VERCEL_OIDC_TOKEN=

# --- Optional: YouTube upload ----------------------------------------------
# Without these, /api/uploadToYoutube returns a 500.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Optional: video generator ---------------------------------------------
RUNPOD_API_KEY=

# --- Rendering --------------------------------------------------------------
# Path to a Chrome/Chromium headless binary. Set in the Docker image already.
# Leave empty to let Remotion download its own headless shell on first render
# (needs egress to remotion.media).
REMOTION_BROWSER_EXECUTABLE=

# Threads within a single render. Renders are queued one at a time regardless.
# Roughly one per core; lower it if the box starts swapping.
RENDER_CONCURRENCY=2

# --- Remotion Studio (only if you run the Studio against this server) -------
# Absolute URL of the Next app, used by Root.tsx to list projects.
REMOTION_APP_URL=http://localhost:3000
# Origin allowed to call /api/findProjects cross-origin.
REMOTION_STUDIO_ORIGIN=http://localhost:3001
